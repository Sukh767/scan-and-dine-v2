{
  "name": "scan-and-dine-v2",
  "version": "1.0.0",
  "private": true,

  "packageManager": "pnpm@11.3.0",

  "scripts": {
    "dev": "concurrently \"pnpm run client\" \"pnpm run restaurant\" \"pnpm run admin\" \"pnpm run server\"",
    "client": "pnpm --filter client dev",
    "restaurant": "pnpm --filter restaurant-admin dev",
    "admin": "pnpm --filter super-admin dev",
    "server": "pnpm --filter server dev",

    "build": "pnpm -r build",

    "install:all": "pnpm install"
  },

  "devDependencies": {
    "concurrently": "^8.2.2"
  },

  "engines": {
    "node": ">=22"
  }
}