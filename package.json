{
  "name": "scan-and-dine-v2",
  "version": "1.0.0",
  "private": true,

  "workspaces": [
    "backend",
    "client",
    "restaurant-admin",
    "super-admin",
    "packages/*"
  ],

  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:client\" \"npm run dev:restaurant\" \"npm run dev:super\"",

    "dev:backend": "npm run dev --workspace=backend",
    "dev:client": "npm run dev --workspace=client",
    "dev:restaurant": "npm run dev --workspace=restaurant-admin",
    "dev:super": "npm run dev --workspace=super-admin",

    "build": "npm run build --workspaces --if-present",

    "install:all": "npm install"
  },

  "devDependencies": {
    "concurrently": "^8.2.2",

    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",

    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/aspect-ratio": "^0.4.2"
  },

  "engines": {
    "node": ">=18.0.0"
  }
}